# Apache settings for independentclaimsconsultants.com (HostGator / cPanel). Generated by _build/build.py.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Always use https://independentclaimsconsultants.com (no www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://independentclaimsconsultants.com/$1 [R=301,L]

# Old WordPress addresses
RewriteRule ^contact\-2/?$ /contact/ [R=301,L,NE]
RewriteRule ^sample\-page/?$ / [R=301,L,NE]
RewriteRule ^services2/?$ / [R=301,L,NE]
RewriteRule ^services3/?$ / [R=301,L,NE]
RewriteRule ^call\-0161\-768765/?$ / [R=301,L,NE]
RewriteRule ^elementor\-hf/independent\-claims\-consultants/?$ / [R=301,L,NE]
RewriteRule ^elementor\-hf/footer/?$ / [R=301,L,NE]
RewriteRule ^claims\.html$ /claims/ [R=301,L,NE]
RewriteRule ^about\.html$ /about/ [R=301,L,NE]
RewriteRule ^advice\.html$ /advice/ [R=301,L,NE]
RewriteRule ^faq\.html$ /faq/ [R=301,L,NE]
RewriteRule ^contact\.html$ /contact/ [R=301,L,NE]
RewriteRule ^feed/?$ / [R=301,L]
RewriteRule ^comments/feed/?$ / [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType video/webm "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
